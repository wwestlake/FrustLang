{
  "schemaVersion": 2,
  "name": "DoorStateMachine",
  "diagramType": "state_machine",
  "targets": [ "frust" ],
  "targetOptions": {
    "frust": {
      "projectType": "lib"
    }
  },
  "events": [
    { "id": "open", "name": "Open" },
    { "id": "close", "name": "Close" }
  ],
  "states": [
    { "id": "closed", "name": "Closed", "initial": true, "terminal": false },
    { "id": "open", "name": "Open", "initial": false, "terminal": false }
  ],
  "transitions": [
    { "id": "closed_to_open", "from": "closed", "to": "open", "event": "open" },
    { "id": "open_to_closed", "from": "open", "to": "closed", "event": "close" }
  ],
  "nodes": []
}
