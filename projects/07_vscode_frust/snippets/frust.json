{
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:args}) -> ${3:i64} = {",
      "\t$0",
      "}"
    ],
    "description": "Function declaration"
  },
  "Public function": {
    "prefix": "pubfn",
    "body": [
      "pub fn ${1:name}(${2:args}) -> ${3:i64} = {",
      "\t$0",
      "}"
    ],
    "description": "Public function declaration"
  },
  "Entry function": {
    "prefix": "entryfn",
    "body": [
      "entry fn start_app() -> i64 = {",
      "\t$0",
      "\t0",
      "}"
    ],
    "description": "Program entry point"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:i64}",
      "}"
    ],
    "description": "Struct declaration"
  },
  "Impl block": {
    "prefix": "impl",
    "body": [
      "impl ${1:TypeName} {",
      "\tfn ${2:method}(${3:&self}) -> ${4:i64} = {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "impl block with a method"
  },
  "If/else": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) { ${2:then} } else { ${3:else} }"
    ],
    "description": "if/else expression"
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for ${1:i} in ${2:0}..${3:n} {",
      "\t$0",
      "}"
    ],
    "description": "for range loop"
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "\t$0",
      "}"
    ],
    "description": "while loop"
  },
  "Loop": {
    "prefix": "loop",
    "body": [
      "loop {",
      "\t$0",
      "\tif (${1:condition}) { break }",
      "}"
    ],
    "description": "loop with a break condition"
  },
  "use self": {
    "prefix": "useself",
    "body": [
      "use self::${1:module};"
    ],
    "description": "Include a sibling file in this pod's build"
  },
  "let": {
    "prefix": "let",
    "body": [
      "let ${1:name} = ${2:value};"
    ],
    "description": "let binding"
  },
  "let mut": {
    "prefix": "letmut",
    "body": [
      "let mut ${1:name} = ${2:value};"
    ],
    "description": "mutable let binding"
  }
}
