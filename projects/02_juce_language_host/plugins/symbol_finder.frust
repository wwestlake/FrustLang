// A real IDE plugin: a lightweight "does this file declare X" checker
// - given a name, reports whether a `fn`/`struct`/`interface` with
// that exact name is declared in a file's text.
//
// No line numbers - that needs converting a byte offset into a line
// number (counting '\n' occurrences up to that offset), which runs
// into the same pointer-arithmetic gap metrics.frust's header
// documents (no way to search "from here" rather than "from the
// start"). This plugin answers "is X declared here at all," a
// genuinely useful, independently-simpler question - not a full
// go-to-definition. Frust's own AST-level tooling (MetadataPanel, this
// IDE's existing AST/metadata inspector) already covers the fuller
// case for files that parse cleanly; this works even on a file that
// currently doesn't (a real advantage of a plain-text scan).

manifest "{\"name\":\"symbol_finder\",\"version\":\"0.1.0\",\"description\":\"Checks whether a fn/struct/interface with a given name is declared in a Frust source file's text\",\"entryPoints\":[\"has_function\",\"has_struct\",\"has_interface\"]}";

extern fn malloc(size: i64) -> String;
extern fn strcpy(dest: String, src: String) -> String;
extern fn strcat(dest: String, src: String) -> String;
extern fn strstr(haystack: String, needle: String) -> String;

// i64 (0/1), not bool, for the same reason linter.frust's header
// documents - no example anywhere in this codebase has ever returned a
// Frust bool (LLVM i1) across the C ABI, and its register-width ABI
// behavior in that direction is unverified.
fn as_i64(cond: bool) -> i64 = {
    if (cond) {
        1
    } else {
        0
    }
}

// `fn NAME(` - matches both `pub fn NAME(...)` and plain `fn NAME(...)`
// (the "pub "/"fn " boundary means searching for "fn NAME(" alone,
// without a leading word-boundary check, is safe: no other keyword in
// Frust's grammar ends in "fn").
pub fn has_function(text: String, name: String) -> i64 = {
    let pattern: String = malloc(256);
    strcpy(pattern, "fn ");
    strcat(pattern, name);
    strcat(pattern, "(");
    as_i64(strstr(text, pattern) != null)
}

// `struct NAME ` - struct_decl's real grammar is `"struct" IDENT "{"`,
// but IDENT is always followed by whitespace before "{" in practice,
// same reasoning as has_function's "(" anchor.
pub fn has_struct(text: String, name: String) -> i64 = {
    let pattern: String = malloc(256);
    strcpy(pattern, "struct ");
    strcat(pattern, name);
    as_i64(strstr(text, pattern) != null)
}

pub fn has_interface(text: String, name: String) -> i64 = {
    let pattern: String = malloc(256);
    strcpy(pattern, "interface ");
    strcat(pattern, name);
    as_i64(strstr(text, pattern) != null)
}
