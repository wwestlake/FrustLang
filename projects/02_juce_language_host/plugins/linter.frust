// A real IDE plugin, not a demo: flags common issues in a Frust source
// file's text (outstanding TODO/FIXME/HACK markers, a missing
// `manifest "...";` declaration - relevant now that "no manifest, no
// load" is the rule for every plugin in this same IDE, a file with no
// exported `pub fn` at all).
//
// Presence-only checks (does X appear anywhere), not occurrence counts
// or line numbers - Frust has no pointer arithmetic today (confirmed:
// no `*ptr + n`, no pointer-difference operator), so "where exactly"
// or "how many times" isn't expressible in pure Frust. `strstr`'s
// null-vs-found result IS safely testable via `== null` - verified
// directly this session (string.fr's own header claims otherwise; that
// claim is stale).
//
// Every `pub fn` here returns i64 (0/1), not bool - no example anywhere
// in this codebase has ever returned a Frust `bool` (LLVM i1) across
// the C ABI to a host, and its register-width ABI behavior in that
// direction is unverified. i64 0/1 is the proven, already-verified
// convention this session uses everywhere a host-visible yes/no result
// crosses the boundary - not a downgrade, just not introducing new,
// untested ABI risk for no reason. `contains` below stays `bool`
// because it never leaves Frust - only called from other Frust code
// in this same file, where bool has been used correctly all session.
//
// Declares its own extern fn for the libc functions it needs (the same
// ones core/src/string.fr wraps) rather than `use`-ing that pod -
// frust_plugin_load() only ever compiles a single file, `use self::`
// only works through frate's multi-file build, so there's no way for a
// single-file plugin to import another .fr file's declarations today.

manifest "{\"name\":\"linter\",\"version\":\"0.1.0\",\"description\":\"Flags outstanding TODO/FIXME/HACK markers, a missing manifest declaration, or no exported pub fn in a Frust source file\",\"entryPoints\":[\"has_todo\",\"has_fixme\",\"has_hack\",\"has_manifest_decl\",\"has_pub_fn\"]}";

extern fn strstr(haystack: String, needle: String) -> String;

fn contains(haystack: String, needle: String) -> bool = {
    strstr(haystack, needle) != null
}

fn as_i64(cond: bool) -> i64 = {
    if (cond) {
        1
    } else {
        0
    }
}

pub fn has_todo(text: String) -> i64 = {
    as_i64(contains(text, "TODO"))
}

pub fn has_fixme(text: String) -> i64 = {
    as_i64(contains(text, "FIXME"))
}

pub fn has_hack(text: String) -> i64 = {
    as_i64(contains(text, "HACK"))
}

// Every plugin loaded by this same IDE must declare one of these
// (frust_plugin_host's "no manifest, no load" rule) - this check lets
// the linter flag a plugin-in-progress that's missing it, before the
// author even tries to load it and gets refused.
pub fn has_manifest_decl(text: String) -> i64 = {
    as_i64(contains(text, "manifest \""))
}

pub fn has_pub_fn(text: String) -> i64 = {
    as_i64(contains(text, "pub fn"))
}
