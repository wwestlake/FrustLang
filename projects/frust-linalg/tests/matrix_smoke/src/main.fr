use core;
use frust_linalg;

fn pass_if(cond: bool) -> i64 = {
    if cond == true { 1 } else { 0 }
}

fn main() -> i64 = {
    let p: Vec3f = vec3f(1.0, 2.0, 3.0);
    let id: Mat4f = mat4f_identity();
    let idp: Vec3f = mat4f_transform_point(id, p);

    let t: Mat4f = mat4f_translation(10.0, 20.0, 30.0);
    let tp: Vec3f = mat4f_transform_point(t, p);

    let s: Mat4f = mat4f_scale(2.0, 3.0, 4.0);
    let sd: Vec3f = mat4f_transform_direction(s, p);

    let combo: Mat4f = mat4f_mul(t, s);
    let cp: Vec3f = mat4f_transform_point(combo, p);
    let inv: Mat4f = mat4f_inverse_translation_scale(combo);
    let roundtrip: Vec3f = mat4f_transform_point(inv, cp);
    let ortho: Mat4f = mat4f_orthographic(-2.0, 2.0, -4.0, 4.0, 1.0, 5.0);
    let trans: Vec3f = mat4f_get_translation(combo);
    let rz: Mat4f = mat4f_rotation_z(pi() * 0.5);
    let rzv: Vec3f = mat4f_transform_direction(rz, vec3f(1.0, 0.0, 0.0));
    let persp: Mat4f = mat4f_perspective_fov_y(pi() * 0.5, 1.0, 1.0, 11.0);
    let look: Mat4f = mat4f_look_at(vec3f(0.0, 0.0, 5.0), vec3f_zero(), vec3f(0.0, 1.0, 0.0));

    pass_if(idp.x == 1.0) + pass_if(idp.y == 2.0) + pass_if(idp.z == 3.0) +
    pass_if(tp.x == 11.0) + pass_if(tp.y == 22.0) + pass_if(tp.z == 33.0) +
    pass_if(sd.x == 2.0) + pass_if(sd.y == 6.0) + pass_if(sd.z == 12.0) +
    pass_if(cp.x == 12.0) + pass_if(cp.y == 26.0) + pass_if(cp.z == 42.0) +
    pass_if(combo.data[0] == 2.0) +
    pass_if(combo.data[5] == 3.0) +
    pass_if(combo.data[10] == 4.0) +
    pass_if(roundtrip.x == 1.0) + pass_if(roundtrip.y == 2.0) + pass_if(roundtrip.z == 3.0) +
    pass_if(ortho.data[0] == 0.5) + pass_if(ortho.data[5] == 0.25) + pass_if(ortho.data[10] == -0.5) +
    pass_if(trans.x == 10.0) + pass_if(trans.y == 20.0) + pass_if(trans.z == 30.0) +
    pass_if(near_zero_f32(rzv.x, 0.000001)) + pass_if(approx_eq_f32(rzv.y, 1.0, 0.000001)) +
    pass_if(approx_eq_f32(persp.data[0], 1.0, 0.000001)) + pass_if(approx_eq_f32(persp.data[5], 1.0, 0.000001)) +
    pass_if(approx_eq_f32(persp.data[10], -1.2, 0.000001)) + pass_if(persp.data[11] == -1.0) +
    pass_if(look.data[14] == -5.0)
}
