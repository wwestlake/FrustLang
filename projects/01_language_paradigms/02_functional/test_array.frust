// Array<N>: a fixed-capacity, real-time-safe buffer (one malloc at
// construction, zero-filled, never grows, bounds-checked on BOTH read and
// write -- unlike Vector<T>, which only ever checked write).
// Hand-predicted: freshly-constructed slot 3 reads back 0 (proves the
// zero-fill), then five writes (10,20,30,40,50), then bracket reads of
// slots 0, 2, and 4 confirm both write and read see the same buffer.
fn main() -> i64 = {
    let mut a: Array<5> = Array::new();
    let before: i64 = a[3];

    a[0] = 10;
    a[1] = 20;
    a[2] = 30;
    a[3] = 40;
    a[4] = 50;

    let x0: i64 = a[0];
    let x2: i64 = a[2];
    let x4: i64 = a[4];

    before * 1000000 + x0 * 10000 + x2 * 100 + x4
}
