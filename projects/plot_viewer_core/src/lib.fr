extern fn host_set_noise_perm_val(idx: i64, val: i64);




// Seeds the C++ Simplex noise permutation table using our Frust RNG.
pub fn seed_procedural_noise(seed: i64) = {
    let mut rng = core::xoshiro256_init(seed);
    
    // Frust doesn't have local array variables yet, so we use a raw memory buffer
    
    // Allocate 256 i64s
    let mut perm: raw* i64 = core::malloc(256 * 8) as raw* i64;
    
    let mut i: i64 = 0;
    while (i < 256) {
        core::set_i64(perm as String, i, i);
        i = i + 1;
    };
    
    // Fisher-Yates shuffle
    i = 255;
    while (i > 0) {
        let j: i64 = rng.next_range(0, i + 1);
        let tmp: i64 = core::get_i64(perm as String, i);
        core::set_i64(perm as String, i, core::get_i64(perm as String, j));
        core::set_i64(perm as String, j, tmp);
        i = i - 1;
    };
    
    // Send to C++
    i = 0;
    while (i < 256) {
        host_set_noise_perm_val(i, core::get_i64(perm as String, i));
        i = i + 1;
    };
    
    core::free(perm as raw* i8);
}
