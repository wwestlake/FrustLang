manifest "{\"name\":\"lifecycle_plugin\",\"version\":\"0.1.0\",\"description\":\"Example plugin exercising the recommended lifecycle convention\",\"entryPoints\":[\"on_init\",\"on_event\",\"on_unload\"]}";

pub fn on_init() -> i64 = {
    111
}

pub fn on_event(id: i64, arg: i64) -> i64 = {
    id + arg
}

pub fn on_unload() -> i64 = {
    222
}
