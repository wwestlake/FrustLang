struct Hist4f {
    min: f64,
    max: f64,
    bin0: f64,
    bin1: f64,
    bin2: f64,
    bin3: f64,
    underflow: f64,
    overflow: f64
}

pub fn hist4_uniform(min: f64, max: f64) -> Hist4f = {
    Hist4f {
        min: min,
        max: max,
        bin0: 0.0,
        bin1: 0.0,
        bin2: 0.0,
        bin3: 0.0,
        underflow: 0.0,
        overflow: 0.0
    }
}

pub fn hist4_bin_width(hist: Hist4f) -> f64 = {
    (hist.max - hist.min) / 4.0
}

pub fn hist4_bin_index(hist: Hist4f, value: f64) -> i64 = {
    let width: f64 = hist4_bin_width(hist);
    if (value < hist.min) {
        -1
    } else {
        if (value >= hist.max) {
            4
        } else {
            if (value < hist.min + width) {
                0
            } else {
                if (value < hist.min + width * 2.0) {
                    1
                } else {
                    if (value < hist.min + width * 3.0) { 2 } else { 3 }
                }
            }
        }
    }
}

pub fn hist4_fill(hist: Hist4f, value: f64) -> Hist4f = {
    hist4_fill_weight(hist, value, 1.0)
}

pub fn hist4_fill_weight(hist: Hist4f, value: f64, weight: f64) -> Hist4f = {
    let index: i64 = hist4_bin_index(hist, value);
    Hist4f {
        min: hist.min,
        max: hist.max,
        bin0: hist.bin0 + if (index == 0) { weight } else { 0.0 },
        bin1: hist.bin1 + if (index == 1) { weight } else { 0.0 },
        bin2: hist.bin2 + if (index == 2) { weight } else { 0.0 },
        bin3: hist.bin3 + if (index == 3) { weight } else { 0.0 },
        underflow: hist.underflow + if (index < 0) { weight } else { 0.0 },
        overflow: hist.overflow + if (index > 3) { weight } else { 0.0 }
    }
}

pub fn hist4_count(hist: Hist4f, index: i64) -> f64 = {
    if (index == 0) { hist.bin0 } else {
        if (index == 1) { hist.bin1 } else {
            if (index == 2) { hist.bin2 } else {
                if (index == 3) { hist.bin3 } else { 0.0 }
            }
        }
    }
}

pub fn hist4_total(hist: Hist4f) -> f64 = {
    hist.bin0 + hist.bin1 + hist.bin2 + hist.bin3
}

pub fn hist4_bin_center(hist: Hist4f, index: i64) -> f64 = {
    let width: f64 = hist4_bin_width(hist);
    if (index == 0) {
        hist.min + 0.5 * width
    } else {
        if (index == 1) {
            hist.min + 1.5 * width
        } else {
            if (index == 2) {
                hist.min + 2.5 * width
            } else {
                if (index == 3) { hist.min + 3.5 * width } else { hist.min }
            }
        }
    }
}

pub fn hist4_density(hist: Hist4f, index: i64) -> f64 = {
    let total: f64 = hist4_total(hist);
    if (total <= 0.0) { 0.0 } else { hist4_count(hist, index) / (total * hist4_bin_width(hist)) }
}
